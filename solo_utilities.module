declare(strict_types=1);

/**
 * @file
 * Add custom features to Solo.
 *
 * Filename:     solo_utilities.module
 * Website:      https://www.flashwebcenter.com
 * Description:  Custom features for the Solo theme, including library loading
 * based on conditions.
 * Developer:    Alaa Haddad https://www.alaahaddad.com.
 */
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\solo_utilities\Hook\SoloUtilitiesHooks;
use Drupal\solo_utilities\Service\BlockTitleVisibilityMigrator;
use Drupal\Component\Utility\DeprecationHelper;
