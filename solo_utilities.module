<?php

/**
 * @file
 * Add custom features to Solo.
 *
 * Filename:     solo_utilities.module
 * Website:      https://www.flashwebcenter.com
 * Description:  Custom features for the Solo theme, including library loading
 * based on conditions.
 * Developer:    Alaa Haddad https://www.alaahaddad.com.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\block\BlockInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\node\NodeInterface;
use Drupal\Core\Template\Attribute;

/**
 * Implements hook_help().
 */
function solo_utilities_help($route_name, RouteMatchInterface $route_match) {
  if ($route_name === 'help.page.solo_utilities') {
    return _solo_utilities_helper_render_readme();
  }
  return NULL;
}

/**
 * Helper function to render README.md.
 */
function _solo_utilities_helper_render_readme() {
  $text = file_get_contents(__DIR__ . "/README.md");

  if (!\Drupal::moduleHandler()->moduleExists('markdown')) {
    return '<pre>' . $text . '</pre>';
  }

  // Use the Markdown filter to render the README.
  $filter_manager = \Drupal::service('plugin.manager.filter');
  $settings = \Drupal::configFactory()
    ->get('markdown.settings')
    ->getRawData();
  $config = ['settings' => $settings];
  $filter = $filter_manager->createInstance('markdown', $config);
  return $filter->process($text, 'en');
}

/**
 * Implements hook_preprocess_HOOK() for page templates.
 */
function solo_utilities_preprocess_page(&$variables) {
  // Check if Solo theme or a sub-theme is active before attaching libraries.
  if (solo_utilities__is_solo_or_sub_in_hierarchy_active()) {
    $negotiator = \Drupal::service('solo_utilities.color_schemes_negotiator');
    $negotiator->evaluateRules($variables);
  }
}

/**
 * Helper function to check if a theme is in the Solo hierarchy.
 *
 * TRUE if the theme or any of its base themes is 'solo', FALSE otherwise.
 */
function solo_utilities__is_solo_in_theme_hierarchy($theme_name) {
  $theme_handler = \Drupal::service('theme_handler');
  $theme_info = $theme_handler->getTheme($theme_name);

  // If the theme is 'solo', return TRUE.
  if ($theme_name === 'solo') {
    return TRUE;
  }

  // If there are base themes, check them recursively.
  if (!empty($theme_info->info['base theme'])) {
    foreach ((array) $theme_info->info['base theme'] as $base_theme_name) {
      if (solo_utilities__is_solo_in_theme_hierarchy($base_theme_name)) {
        return TRUE;
      }
    }
  }

  // If 'solo' was not found in the hierarchy, return FALSE.
  return FALSE;
}

/**
 * Check if the Solo theme or its sub-themes are active in the front-end.
 *
 * TRUE if 'solo' or its sub-themes are in the active front-end theme
 * hierarchy, FALSE otherwise.
 */
function solo_utilities__is_solo_or_sub_in_hierarchy_active() {
  // Get the front-end (default) theme's name from configuration.
  $default_theme = \Drupal::config('system.theme')->get('default');

  // Check if 'solo' is the default theme or in the base theme hierarchy.
  return solo_utilities__is_solo_in_theme_hierarchy($default_theme);
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function solo_utilities_form_node_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if (solo_utilities__is_solo_or_sub_in_hierarchy_active()) {
    $default_theme = \Drupal::config('system.theme')->get('default');

    if (theme_get_setting('enable_custom_node_width', $default_theme)) {
      $node = $form_state->getFormObject()->getEntity();
      if ($node instanceof NodeInterface) {
        $current_width_class = 'none';
        $node_id = $node->id();

        if ($node_id) {
          $current_width = \Drupal::entityTypeManager()->getStorage('node_width')->loadByProperties(['node_id' => $node_id]);
          $current_width_class = !empty($current_width) ? reset($current_width)->get('width_class')->value : 'none';
        }

        $width_options = [
          'none' => t('None'),
          'sw-800' => t('800px / 50rem'),
          'sw-1024' => t('1024px / 64rem'),
          'sw-1280' => t('1280px / 80rem'),
          'sw-1440' => t('1440px / 90rem'),
          'sw-1600' => t('1600px / 100rem'),
          'sw-1920' => t('1920px / 120rem'),
          'sw-2560' => t('2560px / 160rem'),
          'sw-100' => t('100%'),
        ];

        $form['custom_node_width'] = [
          '#type' => 'select',
          '#title' => t('Custom Width'),
          '#options' => $width_options,
          '#default_value' => $current_width_class,
          '#attributes' => ['name' => 'custom_node_width'],
          '#weight' => 999,
        ];

        // Add a custom submit handler to ensure the width gets correctly.
        $form['#submit'][] = 'solo_utilities__node_form_submit';
      }
    }
  }
}

/**
 * Custom submit handler for node form.
 */
function solo_utilities__node_form_submit($form, FormStateInterface $form_state) {
  // Ensure custom width is saved to the node.
  $node = $form_state->getFormObject()->getEntity();
  if ($node instanceof NodeInterface) {
    $custom_width = $form_state->getValue('custom_node_width');
    \Drupal::request()->request->set('custom_node_width', $custom_width);
  }
}

/**
 * Implements hook_node_presave().
 *
 * Saves the custom width value when the node is saved.
 */
function solo_utilities_node_presave(NodeInterface $node) {
  // Check if the Solo theme or its sub-themes are active.
  if (solo_utilities__is_solo_or_sub_in_hierarchy_active()) {
    // Use the request stack to get the POST data during node save.
    $custom_width = \Drupal::request()->request->get('custom_node_width');
    if ($custom_width === NULL) {
      // Exit if no width is provided.
      return;
    }

    $node_width_storage = \Drupal::entityTypeManager()->getStorage('node_width');
    $node_id = $node->id();

    if ($node_id) {
      if ($custom_width && $custom_width !== 'none') {
        $existing = $node_width_storage->loadByProperties(['node_id' => $node_id]);

        if (!empty($existing)) {
          $node_width = reset($existing);
          $node_width->set('width_class', $custom_width);
        }
        else {
          $node_width = $node_width_storage->create([
            'node_id' => $node_id,
            'width_class' => $custom_width,
          ]);
        }

        $node_width->save();
      }
      elseif ($custom_width === 'none') {
        // Remove custom width if 'None' is selected.
        $existing = $node_width_storage->loadByProperties(['node_id' => $node_id]);

        if (!empty($existing)) {
          $node_width = reset($existing);
          $node_width->delete();
        }
      }
    }
  }
}

/**
 * Implements hook_node_insert().
 *
 * Saves the custom width value when a new node is created.
 */
function solo_utilities_node_insert(NodeInterface $node) {
  // Check if the Solo theme or its sub-themes are active.
  if (solo_utilities__is_solo_or_sub_in_hierarchy_active()) {
    // Use the request object to get the POST data during node save.
    $custom_width = \Drupal::request()->request->get('custom_node_width');

    // Check if custom width is not NULL and not 'none'.
    if ($custom_width !== NULL && $custom_width !== 'none') {
      // Get the storage for the node_width entity.
      $node_width_storage = \Drupal::entityTypeManager()->getStorage('node_width');

      // Create and save a new node_width entity for the node.
      $node_width = $node_width_storage->create([
        'node_id' => $node->id(),
        'width_class' => $custom_width,
      ]);

      // Save the node_width entity.
      $node_width->save();
    }
  }
}

/**
 * Checks if block title visibility feature is enabled via theme settings.
 *
 * - Returns TRUE if the active front-end theme or its base theme is 'solo'
 *   AND the active theme settings have 'enable_block_title_visibility' enabled.
 */
function solo_utilities__is_block_title_visibility_enabled(): bool {
  $theme_name = \Drupal::config('system.theme')->get('default');

  // Only proceed if 'solo' is in the active theme hierarchy.
  if (!solo_utilities__is_solo_in_theme_hierarchy($theme_name)) {
    return FALSE;
  }

  return (bool) theme_get_setting('enable_block_title_visibility', $theme_name);
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
function solo_utilities_form_block_form_alter(array &$form, FormStateInterface $form_state): void {
  if (!solo_utilities__is_block_title_visibility_enabled()) {
    return;
  }

  $block = $form_state->getFormObject()?->getEntity();
  if (!$block instanceof BlockInterface) {
    return;
  }

  // If the block does NOT support 'label_display', do not alter the form.
  if (!isset($form['settings']['label_display'])) {
    return;
  }

  // Capture original label_display value and stored custom setting.
  $original = $form['settings']['label_display']['#default_value'] ?? NULL;
  $stored = $block->get('settings')['solo_block_title_visibility'] ?? NULL;

  // Determine the default for dropdown.
  $default = $stored ?? match (TRUE) {
    $original === 'visible' || $original === TRUE => 'visible',
    $original === '0' || $original === FALSE => 'visually_hidden',
    $original === NULL => 'none',
    default => 'visible',
  };

  // Unset the core checkbox.
  unset($form['settings']['label_display']);

  $dropdown_visibility = [
    '#type' => 'select',
    '#title' => t('Block title visibility mode'),
    '#options' => [
      'visible' => t('Visible (always render)'),
      'visually_hidden' => t('Visually hidden (screen readers only)'),
      'none' => t('Do not render at all'),
    ],
    '#default_value' => $default,
    '#description' => t('Controls how this block title is rendered in the HTML.'),
    '#parents' => ['settings', 'solo_block_title_visibility'],
  ];

  $heading_level = $block->get('settings')['solo_block_title_tag'] ?? 'h2';
  $dropdown_tag = [
    '#type' => 'select',
    '#title' => t('Block title tag'),
    '#options' => [
      'h1' => 'H1',
      'h2' => 'H2',
      'h3' => 'H3',
      'h4' => 'H4',
      'h5' => 'H5',
      'h6' => 'H6',
    ],
    '#default_value' => $heading_level,
    '#description' => t('Choose the HTML heading tag to wrap the block title.'),
    '#parents' => ['settings', 'solo_block_title_tag'],
    '#states' => [
      'visible' => [
        ':input[name="settings[solo_block_title_visibility]"]' => ['!value' => 'none'],
      ],
    ],
  ];

  // Insert both fields after 'label'.
  $new_settings = [];
  foreach ($form['settings'] as $key => $field) {
    $new_settings[$key] = $field;
    if ($key === 'label') {
      $new_settings['solo_block_title_visibility'] = $dropdown_visibility;
      $new_settings['solo_block_title_tag'] = $dropdown_tag;
    }
  }
  $form['settings'] = $new_settings;

  // Attach entity builder.
  $form['#entity_builders'][] = '_solo_utilities_block_form_entity_builder';
}

/**
 * Saves custom visibility mode setting into block config.
 */
function _solo_utilities_block_form_entity_builder($entity_type, BlockInterface $block, array &$form, FormStateInterface $form_state): void {
  // Get current settings.
  $settings = $block->get('settings');

  // Update visibility setting if present.
  $visibility = $form_state->getValue(['settings', 'solo_block_title_visibility']);
  if (isset($visibility)) {
    $settings['solo_block_title_visibility'] = $visibility;
  }

  // Update heading tag if present.
  $tag = $form_state->getValue(['settings', 'solo_block_title_tag']);
  if (isset($tag)) {
    $settings['solo_block_title_tag'] = $tag;
  }

  // Save updated settings.
  $block->set('settings', $settings);
}

/**
 * Implements hook_preprocess_block().
 */
function solo_utilities_preprocess_block(array &$variables): void {
  $variables['solo_block_title_visibility_enabled'] = solo_utilities__is_block_title_visibility_enabled();

  if (!$variables['solo_block_title_visibility_enabled']) {
    return;
  }

  $id = $variables['elements']['#id'] ?? NULL;
  if (!$id) {
    return;
  }

  /** @var \Drupal\block\BlockInterface|null $block */
  $block = \Drupal::entityTypeManager()
    ->getStorage('block')
    ->load($id);
  if (!$block instanceof BlockInterface) {
    return;
  }

  $settings = $block->get('settings') ?? [];

  // Resolve final visibility mode.
  $custom_mode = $settings['solo_block_title_visibility'] ?? NULL;
  $legacy = $settings['label_display'] ?? NULL;

  $mode = $custom_mode ?? match (TRUE) {
    $legacy === 'visually_hidden',
    $legacy === '0',
    $legacy === FALSE,
    $legacy === NULL => 'visually_hidden',

    $legacy === '1',
    $legacy === TRUE => 'visible',

    default => 'visible',
  };


  // Store for use in Twig.
  $variables['configuration']['solo_block_title_visibility'] = $mode;

  // Ensure title_attributes is always safe.
  if (!isset($variables['title_attributes']) || !($variables['title_attributes'] instanceof Attribute)) {
    $variables['title_attributes'] = new Attribute($variables['title_attributes'] ?? []);
  }

  // Ensure label is available if missing.
  if (empty($variables['label']) && empty($variables['configuration']['label'])) {
    $label = $variables['elements']['#configuration']['label'] ?? NULL;
    if (!$label && !empty($settings['label'])) {
      $label = $settings['label'];
    }

    // Clean fallback for plugin ID.
    if (!$label && !empty($variables['plugin_id'])) {
      if (str_starts_with($variables['plugin_id'], 'views_block:')) {
        // Extract view and display ID: views_block:view_id-display_id.
        $plugin_parts = explode(':', $variables['plugin_id']);
        $view_parts = explode('-', $plugin_parts[1] ?? '');
        if (count($view_parts) >= 2) {
          [$view_id, $display_id] = $view_parts;
          $label = ucwords(str_replace('_', ' ', $view_id)) . ' - ' . ucwords(str_replace('_', ' ', $display_id));
        }
      }
      else {
        // Fallback for other plugin types.
        $label = ucwords(str_replace(['_', ':'], [' ', ' '], $variables['plugin_id']));
      }
    }

    $variables['label'] = $label;
    $variables['configuration']['label'] = $label;
  }

  // Apply final visibility behavior.
  switch ($mode) {
    case 'none':
      unset($variables['label']);
      break;

    case 'visually_hidden':
      $variables['title_attributes']->addClass('visually-hidden');
      break;

    case 'visible':
    default:
      // No change.
      break;
  }

  $allowed_tags = ['h1', 'h2', 'h3', 'h4', 'h5', 'h6'];
  $tag = $settings['solo_block_title_tag'] ?? 'h2';
  $tag = in_array($tag, $allowed_tags, TRUE) ? $tag : 'h2';
  $variables['configuration']['solo_block_title_tag'] = $tag;

}
