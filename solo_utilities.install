<?php

/**
 * @file
 * Install, update and uninstall hooks for Solo Utilities.
 */

declare(strict_types=1);

/**
 * @file
 * Defines the schema for storing custom node width settings.
 */

/**
 * Implements hook_schema().
 */
function solo_utilities_schema(): array {
  return [
    'solo_theme_node_width' => [
      'description' => 'Table to store custom width classes for nodes.',
      'fields' => [
        'id' => [
          'type' => 'serial',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'description' => 'Primary key: Unique ID for each entry.',
        ],
        'node_id' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'description' => 'The ID of the node.',
        ],
        'width_class' => [
          'type' => 'varchar',
          'length' => 255,
          'not null' => TRUE,
          'description' => 'The width class applied to the node.',
        ],
      ],
      'primary key' => ['id'],
      'indexes' => [
        'node_id' => ['node_id'],
      ],
    ],
  ];
}

/**
 * Implements hook_uninstall().
 */
function solo_utilities_uninstall(): void {
  $database = \Drupal::database();
  $schema_handler = $database->schema();

  /*
   * --------------------------------------------------------------------------
   * Schema cleanup (must be first and fully guarded).
   * --------------------------------------------------------------------------
   */
  if ($schema_handler->tableExists('solo_theme_node_width')) {
    try {
      $schema_handler->dropTable('solo_theme_node_width');
    }
    catch (\Throwable $e) {
      \Drupal::logger('solo_utilities')->warning(
        'Failed to drop table solo_theme_node_width during uninstall: @message',
        ['@message' => $e->getMessage()]
      );
    }
  }

  /*
   * --------------------------------------------------------------------------
   * Theme config cleanup (must NOT touch schema-dependent services).
   * --------------------------------------------------------------------------
   */
  $theme_handler = \Drupal::service('theme_handler');
  $themes = $theme_handler->listInfo();
  $config_factory = \Drupal::configFactory();

  foreach ($themes as $theme_name => $theme) {
    $base_theme = $theme->info['base theme'] ?? NULL;

    $base_themes = is_array($base_theme)
      ? array_keys($base_theme)
      : (is_string($base_theme) ? [$base_theme] : []);

    if ($theme_name !== 'solo' && !in_array('solo', $base_themes, TRUE)) {
      continue;
    }

    $config = $config_factory->getEditable("{$theme_name}.settings");
    $has_changes = FALSE;

    if ($config->get('enable_custom_widths') !== NULL) {
      $config->clear('enable_custom_widths');
      $has_changes = TRUE;
    }

    // Guard entity access during uninstall.
    if (\Drupal::entityTypeManager()->hasDefinition('node_type')) {
      $content_types = \Drupal::entityTypeManager()
        ->getStorage('node_type')
        ->loadMultiple();

      foreach ($content_types as $type) {
        $key = "site_width_{$type->id()}";
        if ($config->get($key) !== NULL) {
          $config->clear($key);
          $has_changes = TRUE;
        }
      }
    }

    if ($has_changes) {
      $config->save();
      $config_factory->reset("{$theme_name}.settings");
    }
  }

}

/**
 * Implements hook_modules_enabled().
 */
function solo_utilities_modules_enabled(array $modules): void {
  if (
    in_array('solo_utilities', $modules, TRUE) &&
    \Drupal::hasService('solo_utilities.block_title_visibility_migrator')
  ) {
    \Drupal::service('solo_utilities.block_title_visibility_migrator')
      ->migrateLegacySettings();
  }
}

/**
 * Implements hook_modules_disabled().
 */
function solo_utilities_modules_disabled(array $modules): void {
  if (
    in_array('solo_utilities', $modules, TRUE) &&
    \Drupal::hasService('solo_utilities.block_title_visibility_migrator')
  ) {
    \Drupal::service('solo_utilities.block_title_visibility_migrator')
      ->cleanupBlockSettings();
  }
}

/**
 * Update hook to migrate legacy block visibility settings.
 */
function solo_utilities_update_8001(): void {
  if (\Drupal::hasService('solo_utilities.block_title_visibility_migrator')) {
    \Drupal::service('solo_utilities.block_title_visibility_migrator')
      ->migrateLegacySettings();
  }
}

/**
 * Move block title settings from block plugin settings to third-party.
 */
function solo_utilities_update_8002(): string {
  $changed = \Drupal::service('solo_utilities.block_title_visibility_migrator')
    ->moveToThirdPartySettings();
  return (string) t('Moved block title settings to third-party settings on @count block(s).', ['@count' => $changed]);
}
