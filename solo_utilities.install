<?php

/**
 * @file
 * Defines the schema for storing custom node width settings.
 */

/**
 * Implements hook_schema().
 *
 * Defines the database schema for the solo_utilities module.
 *
 *   The schema definition for the solo_utilities module.
 */
function solo_utilities_schema() {
  return [
    'solo_theme_node_width' => [
      'description' => 'Table to store custom width classes for nodes.',
      'fields' => [
        'id' => [
          'type' => 'serial',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'description' => 'Primary key: Unique ID for each entry.',
        ],
        'node_id' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'description' => 'The ID of the node.',
        ],
        'width_class' => [
          'type' => 'varchar',
          'length' => 255,
          'not null' => TRUE,
          'description' => 'The width class applied to the node.',
        ],
      ],
      'primary key' => ['id'],
      'indexes' => [
        'node_id' => ['node_id'],
      ],
    ],
  ];
}

/**
 * Implements hook_uninstall().
 *
 * Cleans up Solo Utilities config and schema during uninstall.
 */
function solo_utilities_uninstall(): void {
  $schema_handler = \Drupal::database()->schema();

  // Drop the custom node width table if it exists.
  if ($schema_handler->tableExists('solo_theme_node_width')) {
    try {
      $schema_handler->dropTable('solo_theme_node_width');
    }
    catch (\Exception $e) {
      \Drupal::logger('solo_utilities')->warning('Failed to drop table solo_theme_node_width: @message', [
        '@message' => $e->getMessage(),
      ]);
    }
  }

  // Clean up block visibility settings.
  \Drupal::service('solo_utilities.block_title_visibility_migrator')->cleanupBlockSettings();
}

/**
 * Implements hook_modules_enabled().
 */
function solo_utilities_modules_enabled(array $modules): void {
  if (in_array('solo_utilities', $modules, TRUE)) {
    \Drupal::service('solo_utilities.block_title_visibility_migrator')->migrateLegacySettings();
  }
}

/**
 * Update hook to migrate legacy block visibility settings.
 */
function solo_utilities_update_8001(): void {
  \Drupal::service('solo_utilities.block_title_visibility_migrator')->migrateLegacySettings();
}
