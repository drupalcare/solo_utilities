<?php

/**
 * @file
 * Defines the schema for storing custom node width settings.
 */

use Drupal\block\BlockInterface;

/**
 * Implements hook_schema().
 *
 * Defines the database schema for the solo_utilities module.
 *
 *   The schema definition for the solo_utilities module.
 */
function solo_utilities_schema() {
  return [
    'solo_theme_node_width' => [
      'description' => 'Table to store custom width classes for nodes.',
      'fields' => [
        'id' => [
          'type' => 'serial',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'description' => 'Primary key: Unique ID for each entry.',
        ],
        'node_id' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'description' => 'The ID of the node.',
        ],
        'width_class' => [
          'type' => 'varchar',
          'length' => 255,
          'not null' => TRUE,
          'description' => 'The width class applied to the node.',
        ],
      ],
      'primary key' => ['id'],
      'indexes' => [
        'node_id' => ['node_id'],
      ],
    ],
  ];
}

/**
 * Implements hook_uninstall().
 *
 * Cleans up Solo Utilities config and schema during uninstall.
 */
function solo_utilities_uninstall(): void {
  $schema_handler = \Drupal::database()->schema();

  // Drop the custom node width table if it exists.
  if ($schema_handler->tableExists('solo_theme_node_width')) {
    try {
      $schema_handler->dropTable('solo_theme_node_width');
    }
    catch (\Exception $e) {
      \Drupal::logger('solo_utilities')->warning('Failed to drop table solo_theme_node_width: @message', [
        '@message' => $e->getMessage(),
      ]);
    }
  }

  // Clean solo_block_title_visibility only from blocks assigned to Solo or
  // its sub-themes.
  $storage = \Drupal::entityTypeManager()->getStorage('block');
  $ids = $storage->getQuery()->accessCheck(FALSE)->execute();

  foreach ($storage->loadMultiple($ids) as $block) {
    if (!$block instanceof BlockInterface) {
      continue;
    }

    $theme_name = $block->getTheme();
    if (!solo_utilities__is_solo_in_theme_hierarchy($theme_name)) {
      continue;
    }

    $settings = $block->get('settings');
    if (isset($settings['solo_block_title_visibility'])) {
      unset($settings['solo_block_title_visibility']);
      $block->set('settings', $settings);
      $block->save();
    }
  }
}

/**
 * Migrate legacy label_display values to solo_block_title_visibility.
 */
function solo_utilities_update_8001(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('block');
  $ids = $storage->getQuery()->accessCheck(FALSE)->execute();

  $count = 0;

  foreach ($storage->loadMultiple($ids) as $block) {
    if (!$block instanceof \Drupal\block\BlockInterface) {
      continue;
    }

    $theme_name = $block->getTheme();
    if (!solo_utilities__is_solo_in_theme_hierarchy($theme_name)) {
      continue;
    }

    $settings = $block->get('settings');
    $has_new = isset($settings['solo_block_title_visibility']);
    $legacy = $settings['label_display'] ?? NULL;

    if (!$has_new) {
      $settings['solo_block_title_visibility'] = match (TRUE) {
        $legacy === 'visible',
        $legacy === TRUE,
        $legacy === '1' => 'visible',

        $legacy === '0',
        $legacy === FALSE => 'visually_hidden',

        $legacy === NULL => 'none',

        default => 'visible',
      };

      $block->set('settings', $settings);
      $block->save();
    }
  }

}
